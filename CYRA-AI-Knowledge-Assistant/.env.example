# CYRA configuration. Copy this file to ".env" (same folder) and edit the copy.
# NEVER share or commit ".env": it holds your private API key.

# --- Required -------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey and paste it after the "=".
GOOGLE_API_KEY=your_gemini_api_key_here

# The project whose documents CYRA may search. Ingestion stamps it on every
# passage and the chatbot only retrieves passages carrying it.
# 1-64 characters: letters, digits, . _ -   (must start with a letter or digit)
PROJECT_ID=cyra

# --- Storage (defaults are fine; paths are relative to this folder) ---------
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=corpus
CORPUS_DIR=./corpus
# Use a Qdrant server instead of the embedded database (optional):
# QDRANT_URL=http://localhost:6333

# --- Gemini (optional) ------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the model above is unavailable:
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash
GENERATION_TIMEOUT_S=60

# --- Retrieval (optional) ---------------------------------------------------
RETRIEVAL_TOP_K=8
RERANK_ENABLED=false

# --- OCR (optional) ---------------------------------------------------------
# Pages with no selectable text are OCR'd automatically when Tesseract is installed.
# Also OCR pictures on pages that already have text (slow, usually unnecessary):
OCR_EMBEDDED_IMAGES=false
# Only if Tesseract is installed somewhere unusual:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Web browser access -----------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
