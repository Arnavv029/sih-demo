# CYRA configuration for AICTE Portal
# NEVER share or commit ".env": it holds your private API key.

# --- Required -------------------------------------------------------------
# Optional Gemini API Key from https://aistudio.google.com/apikey
# If omitted or empty, the system operates in grounded extractive regulatory mode without crashing.
GOOGLE_API_KEY=

# The project whose documents CYRA may search.
PROJECT_ID=aicte

# --- Low-Memory Cloud Optimization (Essential for Render Free Tier <= 512MB RAM) ---
# Prevents heavy 2GB model downloads and PyTorch crashes; uses ultra-lightweight micro-embedder (< 30MB RAM)
LOW_MEMORY=true
FAST_EMBEDDING=true

# --- Storage (defaults are fine; paths are relative to this folder) ---------
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=corpus
CORPUS_DIR=./corpus

# --- Gemini (optional) ------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
GENERATION_TIMEOUT_S=60

# --- Retrieval (optional) ---------------------------------------------------
RETRIEVAL_TOP_K=8
RERANK_ENABLED=false
OCR_EMBEDDED_IMAGES=false

# --- Web browser access -----------------------------------------------------
CORS_ORIGINS=*
